# GameBox / RomM
# RomM 5.1.0 is the latest stable release currently documented for this stack.
# Pin exact digests later if you need byte-for-byte reproducibility.
ROMM_IMAGE=rommapp/romm:5.1.0
ROMM_PORT=6767

# Database
MARIADB_IMAGE=mariadb:11
DB_NAME=romm
DB_USER=romm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Valkey
VALKEY_IMAGE=valkey/valkey:8

# Paths on the host
ROMM_DATA_DIR=./data/romm
ROMM_RESOURCES_DIR=./data/resources
ROMM_LIBRARY_DIR=./roms
ROMM_CONFIG_DIR=./config
ROMM_FIRMWARE_DIR=./bios

# Generate a real value on the preparation machine:
# openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=change-this-to-a-random-secret

# Optional metadata providers. Leave empty for a strictly offline runtime.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
