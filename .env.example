# GameBox / RomM
# Full image: EmulatorJS + Ruffle are bundled for offline browser play.
ROMM_IMAGE=rommapp/romm:5.1.0
ROMM_PORT=6767

# Database
MARIADB_IMAGE=mariadb:11
DB_NAME=romm
DB_USER=romm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Valkey
VALKEY_IMAGE=valkey/valkey:8

# Host paths
# The repository root is mounted as /romm/library so /romm/library/roms is scanned.
ROMM_LIBRARY_DIR=.
ROMM_DATA_DIR=./data/romm
ROMM_RESOURCES_DIR=./data/resources
ROMM_CONFIG_DIR=./config

# Generate once on the preparation machine:
# openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=change-this-to-a-random-secret

# Optional online metadata providers. Leave empty for runtime offline use.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
