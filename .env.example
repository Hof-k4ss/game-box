# GameBox / RomM
ROMM_IMAGE=rommapp/romm:latest
ROMM_PORT=8080

# Database
MARIADB_IMAGE=mariadb:11
DB_NAME=romm
DB_USER=romm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Valkey
VALKEY_IMAGE=valkey/valkey:8

# Paths on the host
ROMM_DATA_DIR=./data/romm
ROMM_RESOURCES_DIR=./data/resources
ROMM_LIBRARY_DIR=./roms
ROMM_ASSETS_DIR=./data/assets
ROMM_CONFIG_DIR=./data/config

# Optional: set these only if you explicitly want online metadata during preparation.
# They are not required for the offline runtime.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
