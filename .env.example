# GameBox / RomM
# Full RomM image: EmulatorJS + Ruffle are bundled for offline browser play.
ROMM_IMAGE=rommapp/romm:5.2.0
ROMM_PORT=6767

# Database
MARIADB_IMAGE=mariadb:11
DB_NAME=romm
DB_USER=romm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Valkey
VALKEY_IMAGE=valkey/valkey:8

# Paths on the host
ROMM_DATA_DIR=./data/romm
ROMM_RESOURCES_DIR=./data/resources
ROMM_LIBRARY_DIR=.
ROMM_CONFIG_DIR=./config

# Generate a real value on the preparation machine:
# openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=change-this-to-a-random-secret

# Optional metadata providers. Leave empty for a strictly offline runtime.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
