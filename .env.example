# GameBox — paramètres simples

# Port web local
GAMEBOX_PORT=6767

# Dossier où se trouvent tes ROMs AVANT import.
# Exemple : /home/USER/downloads/ROMs
ROM_SOURCE_DIR=/home/USER/downloads/ROMs

# Bibliothèque GameBox. Ne pas mettre les ROMs du dépôt Git ici.
ROMS_DIR=./roms
BIOS_DIR=./bios

# false = déplace les fichiers classés ; true = simulation uniquement
IMPORT_DRY_RUN=false
